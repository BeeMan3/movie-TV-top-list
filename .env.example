# Updater Configuration Example
# Copy this file to .env and modify the values as needed

# List size configuration
SCRAPER_MAX_MOVIES=25
SCRAPER_MAX_TV_SHOWS=25
SCRAPER_MAX_TOTAL_ITEMS=50

# Filter configuration (for fresh content optimized for private trackers)
# Set to None to disable a filter
SCRAPER_MIN_YEAR=2020
SCRAPER_MAX_YEAR=None
SCRAPER_MIN_RATING=6.0
SCRAPER_MAX_RATING=None

# TMDb configuration
# Create a free non-commercial credential at https://www.themoviedb.org/settings/api
# Use either the v4 Read Access Token (recommended) or the legacy v3 API Key.
TMDB_READ_ACCESS_TOKEN=
# TMDB_API_KEY=
SCRAPER_TMDB_TRENDING_WINDOW=week

# Request configuration
SCRAPER_REQUEST_TIMEOUT=15
SCRAPER_REQUEST_DELAY=2.0
SCRAPER_REQUEST_RETRIES=3
SCRAPER_RETRY_DELAY=2.0

# Output configuration
SCRAPER_SIMPLE_OUTPUT_FILE=top-list.json
SCRAPER_DETAILED_OUTPUT_FILE=top-list-detailed.json
